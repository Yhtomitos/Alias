{
  "name": "alias-static-analysis",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier --config static-analysis/formatters/prettier.json --ignore-path static-analysis/formatters/prettierignore --check \"**/*.{js,mjs,cjs,ts,tsx,json,jsonc,yml,yaml,css,html}\"",
    "infra:synth": "cdk synth",
    "infra:test": "tsx --test apps/aws/test/alias-stack.test.ts apps/aws/test/sync-item.test.ts",
    "lint": "eslint . --config static-analysis/linters/eslint.config.mjs --max-warnings=0",
    "typecheck": "node static-analysis/type-safety/typecheck-if-present.mjs"
  },
  "dependencies": {
    "aws-cdk-lib": "2.270.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "aws-cdk": "2.1143.0",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0"
  }
}
